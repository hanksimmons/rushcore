<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Godot 4.7.2 ships its own SDK/runtime packages inside the app bundle.
         Listing it first lets the project restore without network access. -->
    <add key="godot-offline" value="/Applications/Godot_mono.app/Contents/Resources/GodotSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
